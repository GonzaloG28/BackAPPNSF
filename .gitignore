# ── Secretos / configuración local ──────────────────────────────────
.env
.env.*
!.env.example

# ── Entorno virtual de Python ───────────────────────────────────────
venv/
.venv/
env/
.env

# ── Cache y bytecode de Python ──────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── Testing ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Archivos de datos / prueba que no deberían ir al repo ──────────
excel_prueba_roster.xlsx
*.xlsx
!seed_data/**/*.xlsx

# ── Snapshots de base de datos (pueden contener datos reales, y quedan
#    desactualizados frente a los scripts de migración) ──────────────
backup_completo.sql
estructura_completa.sql

# ── Editor / SO ──────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────
*.log
